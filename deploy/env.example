# 复制到 /etc/snap2sku/env；文件权限 600、属主 snap2sku:snap2sku，不进入 Git。
# 所有 NUXT_* 名称与 apps/web/nuxt.config.ts 的 runtimeConfig 对齐。

# 监听地址与端口；Nginx 上游端口必须保持一致。
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# 生产门禁访问码。必须配置；不得将真实值写进仓库。
NUXT_ACCESS_CODE=

# 上传签名密钥至少 32 字节；生成方式见运维部署手册。
NUXT_UPLOAD_SIGNING_SECRET=
NUXT_UPLOAD_SIGNING_SECRET_PREVIOUS=

# 视觉模型配置。
NUXT_VISION_API_KEY=
NUXT_VISION_MODEL=glm-4v-flash
NUXT_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# 单价为 0 时费用估算恒为 0，预算熔断不会触发；从模型控制台抄真实单价。
NUXT_VISION_INPUT_PRICE_PER_MILLION=0
NUXT_VISION_OUTPUT_PRICE_PER_MILLION=0
NUXT_VISION_MOCK=0

# Linux 绝对路径；目录须在启动服务前创建并授权给 snap2sku 用户。
NUXT_DATA_DIR=/var/lib/snap2sku

# 试用预算。预算默认 200 元；预占金额请按实际单次成本设置。
NUXT_TRIAL_BUDGET_CNY=200
NUXT_TRIAL_RESERVE_CNY=
# 设置本轮唯一标识，后续按 trialId 清理数据；留空可能导致只能按时间清理。
NUXT_TRIAL_ID=
