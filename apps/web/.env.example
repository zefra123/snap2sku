# 复制本文件为同目录下的 .env 并填入真实值（.env 已被 gitignore，绝不提交）
# 值全部从服务端 runtimeConfig 读取，禁止出现在前端代码或 public/

# 智谱开放平台（bigmodel.cn）控制台创建的 API Key
NUXT_VISION_API_KEY=

# 模型与端点（以智谱控制台文档为准）
NUXT_VISION_MODEL=glm-4v-flash
# 填服务根地址（如下）或完整端点（.../v4/chat/completions）都可以，
# 服务端会自动补全 /chat/completions，两种写法等价。
NUXT_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 估算单价（元/百万 token）。单价为 0 时费用估算恒为 0，预算熔断不会触发；
# 必须从实际使用的模型控制台抄入真实单价，不要使用猜测值。
NUXT_VISION_INPUT_PRICE_PER_MILLION=0
NUXT_VISION_OUTPUT_PRICE_PER_MILLION=0

# 本地没有 key 时置 1：vision.ts 适配器返回固定 mock 识别结果，
# 可走完 上传→识别→表单→SKU→提交 全链路；有 key 后置 0 走真实验收
NUXT_VISION_MOCK=0

# 访问码门禁：留空 = 本地开发时放行全部可写接口；
# 生产启动时缺失即拒绝启动；可写接口必须携带此访问码
NUXT_ACCESS_CODE=

# 图片读取签名密钥：生产必填，至少 32 字节随机值
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
NUXT_UPLOAD_SIGNING_SECRET=
# 轮换期间临时保留旧值，等待 60 秒后删除
NUXT_UPLOAD_SIGNING_SECRET_PREVIOUS=

# SQLite 记录与模型费用账本目录。生产必须设置；该变量单独决定账本位置。
# systemd 的 WorkingDirectory 仍需正确配置（.output 内其他路径仍可能依赖它）。
NUXT_DATA_DIR=

# 本轮试用预算（元）。默认上限为 200；单次模型调用预占金额按实际风险设置。
NUXT_TRIAL_BUDGET_CNY=200
NUXT_TRIAL_RESERVE_CNY=

# 本轮试用标识，用于任务 12 按 trialId 清理测试数据；建议填写唯一标识，不要留空。
NUXT_TRIAL_ID=
