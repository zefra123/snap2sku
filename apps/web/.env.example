# 复制本文件为同目录下的 .env 并填入真实值（.env 已被 gitignore，绝不提交）
# 值全部从服务端 runtimeConfig 读取，禁止出现在前端代码或 public/

# 智谱开放平台（bigmodel.cn）控制台创建的 API Key
NUXT_VISION_API_KEY=

# 模型与端点（以智谱控制台文档为准）
NUXT_VISION_MODEL=glm-4v-flash
NUXT_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 本地没有 key 时置 1：vision.ts 适配器返回固定 mock 识别结果，
# 可走完 上传→识别→表单→SKU→提交 全链路；有 key 后置 0 走真实验收
NUXT_VISION_MOCK=0
